# Local Postgres (created by supabase/README.md step 1). Swap for the Supabase
# pooler URL once the project exists.
DATABASE_URL=postgres://localhost:5432/cs_cc

# Supabase Auth (Google sign-in, restricted to @revspot.ai).
# Leave blank locally: the app falls back to dev sign-in against the profiles table.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
ALLOWED_EMAIL_DOMAIN=revspot.ai

# Gmail for billing (Settings > Mailboxes). A Workspace admin creates an OAuth
# client in Google Cloud: Web application, Internal, Gmail API enabled, redirect
# <APP_URL>/api/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APP_URL=http://localhost:3000
# Encrypts mailbox tokens at rest: openssl rand -base64 32
MAIL_TOKEN_KEY=

# Until Google is set up: a shared code that unlocks pick-your-profile sign-in in
# production (needs SESSION_SECRET). Ignored once the Google client is configured.
ACCESS_CODE=

# Google sign-in uses the same OAuth client as Gmail. Signs the login cookie:
# openssl rand -base64 48
SESSION_SECRET=
# Scheduled jobs call /api/cron/daily and /api/cron/sync with
# "Authorization: Bearer <CRON_SECRET>". Vercel Cron sends it automatically.
CRON_SECRET=
# Slack incoming webhook for alerts and the morning summary (optional).
SLACK_WEBHOOK_URL=
# Client usage (leads + bot calls) from the Revspot admin data. Read-only Mongo
# connection string; the daily job pulls per-org counts from the `revv` database.
MONGODB_URI=
REVV_DB=revv
